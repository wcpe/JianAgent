# =============================================================================
#  JianAgent Server — Environment Variables
#
#  Copy this file to .env and adjust values for your deployment.
#  Lines starting with '#' are comments. Uncomment a line to set the value.
#
#  Markers:
#    REQUIRED (production) — must be set for production deployments
#    Optional               — has a sensible default; override as needed
# =============================================================================


# ── Server ───────────────────────────────────────────────────────────────────

# Host address the HTTP server binds to.
# Optional. Default: 127.0.0.1
HOST=127.0.0.1

# Port the HTTP server listens on. Must be 1–65535.
# Optional. Default: 3400
PORT=3400

# Node environment. Set to "production" for production deployments.
# Controls security defaults (JWT fallback, CORS, bootstrap admin).
# Optional. Default: undefined (treated as development)
# NODE_ENV=production

# Comma-separated list of allowed CORS origins.
# In development (NODE_ENV != production), defaults to
#   http://localhost:5173,http://127.0.0.1:5173
# In production, defaults to an empty list (no cross-origin requests).
# Optional.
# CORS_ORIGINS=https://panel.example.com,https://admin.example.com


# ── Database ─────────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# The parent directory must exist and be writable.
# Optional. Default: ./data/jian-agent.db
DB_PATH=./data/jian-agent.db


# ── Authentication ───────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT tokens.
# REQUIRED (production). Must be at least 32 characters.
# In development, an insecure fallback is used if this is unset.
# JWT_SECRET=your-secret-here-change-me-at-least-32-chars


# ── Authentication Rate Limiting ─────────────────────────────────────────────

# Maximum number of failed login attempts before rate limiting.
# Optional. Default: 10
# AUTH_MAX_LOGIN_ATTEMPTS=10

# Time window (ms) for tracking login attempts.
# Optional. Default: 900000 (15 minutes)
# AUTH_LOGIN_WINDOW_MS=900000


# ── Bootstrap Admin ──────────────────────────────────────────────────────────
# On first startup with an empty database, a bootstrap admin account is
# created automatically. In development this is enabled by default; in
# production it must be explicitly enabled.

# Enable or disable the bootstrap admin account.
# Accepts: true/false, 1/0, yes/no, on/off.
# Optional. Default: true in development, false in production.
# JIAN_AGENT_BOOTSTRAP_ADMIN=true

# Username for the bootstrap admin account.
# Optional. Default: admin
# JIAN_AGENT_BOOTSTRAP_ADMIN_USERNAME=admin

# Password for the bootstrap admin account.
# REQUIRED (production) when bootstrap admin is enabled.
# In development, a random UUID is generated and printed to the console.
# JIAN_AGENT_BOOTSTRAP_ADMIN_PASSWORD=


# ── Encryption ───────────────────────────────────────────────────────────────

# Master key for encrypting sensitive data (e.g. SSH credentials).
# If unset, a key is auto-generated and stored in data/encrypt.key.
# Set this explicitly in production or when sharing state across instances.
# Optional.
# JIANAGENT_ENCRYPT_KEY=your-encryption-key-here


# ── Plugin Bridge ────────────────────────────────────────────────────────────
# The plugin bridge accepts connections from in-game probe plugins.

# Disable the plugin bridge entirely.
# Optional. Default: false
# PLUGIN_BRIDGE_DISABLED=false

# Host address the plugin bridge binds to.
# Optional. Default: 127.0.0.1
# PLUGIN_BRIDGE_HOST=127.0.0.1

# Port the plugin bridge listens on. Must be 1–65535.
# Optional. Default: 3401
# PLUGIN_BRIDGE_PORT=3401


# ── Server Process Lifecycle ─────────────────────────────────────────────────
# Controls how JianAgent detects whether a managed game server has started
# successfully, and how it retries on failure.

# Readiness detection mode: "output" (log pattern), "port" (TCP check),
# or "hybrid" (both).
# Optional. Default: hybrid
# START_READY_MODE=hybrid

# Maximum time (ms) to wait for the server to become ready.
# Optional. Default: 30000
# START_READY_TIMEOUT_MS=30000

# Maximum time (ms) to wait for the port to open (port/hybrid modes).
# Optional. Default: 20000
# START_PORT_CHECK_TIMEOUT_MS=20000

# Interval (ms) between port-open checks.
# Optional. Default: 500
# START_PORT_CHECK_INTERVAL_MS=500

# Maximum time (ms) to wait for a graceful server stop.
# Optional. Default: 30000
# STOP_TIMEOUT_MS=30000

# Number of automatic restart attempts on start failure.
# Optional. Default: 1
# START_RETRY_ATTEMPTS=1

# Base delay (ms) for exponential backoff between retries.
# Optional. Default: 500
# START_RETRY_BASE_DELAY_MS=500

# Maximum delay (ms) cap for exponential backoff.
# Optional. Default: 8000
# START_RETRY_MAX_DELAY_MS=8000


# ── WebSocket / Realtime Gateway ─────────────────────────────────────────────

# Maximum number of concurrent WebSocket connections.
# Optional. Default: 200
# REALTIME_MAX_CONNECTIONS=200

# Time window (ms) for aggregating output messages.
# Optional. Default: 100
# REALTIME_OUTPUT_AGGREGATE_WINDOW_MS=100

# Time window (ms) for deduplicating output messages.
# Optional. Default: 120
# REALTIME_OUTPUT_DEDUP_WINDOW_MS=120

# Time-to-live (ms) for deduplication cache entries.
# Optional. Default: 300000 (5 minutes)
# REALTIME_OUTPUT_DEDUP_TTL_MS=300000

# Interval (ms) for cleaning up expired deduplication entries.
# Optional. Default: 60000 (1 minute)
# REALTIME_DEDUP_CLEANUP_INTERVAL_MS=60000


# ── Platform Runtime ─────────────────────────────────────────────────────────
# Declares the capabilities of the deployment environment.

# Storage backend dialect: sqlite, postgresql, or mysql.
# Optional. Default: sqlite
# STORAGE_DIALECT=sqlite

# Log backend mode: local-file, loki, or hybrid.
# When set to "loki" or "hybrid", LOKI_BASE_URL must also be set.
# Optional. Default: local-file
# LOG_BACKEND_MODE=local-file

# Probe plugin runtime kind. Determines protocol compatibility.
# Values: paper-1.20.4, paper-1.21+, folia, velocity, fabric, forge, unknown.
# Optional. Default: paper-1.20.4
# PROBE_RUNTIME_KIND=paper-1.20.4

# WebSocket capacity mode: standard or high-scale.
# Optional. Default: standard
# REALTIME_CAPACITY_MODE=standard


# ── Logging / Loki ───────────────────────────────────────────────────────────

# Base URL for a Grafana Loki instance (e.g. http://loki:3100).
# Required when LOG_BACKEND_MODE is "loki" or "hybrid".
# Optional. Default: unset (Loki disabled)
# LOKI_BASE_URL=http://loki:3100


# ── Alerts ───────────────────────────────────────────────────────────────────

# Random jitter (ms) added before dispatching alerts to avoid thundering herd.
# Optional. Default: internal default (see alert-engine.service.ts)
# ALERT_JITTER_MS=


# ── Java Runtime Discovery ──────────────────────────────────────────────────

# Standard JAVA_HOME variable. JianAgent reads it (but does not set it)
# to discover installed Java runtimes for managed servers.
# Optional. Typically set at the OS / shell level.
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk
